sx7ainlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le8b37rc" class="W4V2qg comp-le8b37rc wixui-image" title="Sydney on the Moon"><div data-testid="linkElement" class="apPOZK"><img fetchpriority="high" sizes="1298px" srcSet="https://static.wixstatic.com/media/11d052_6b841334f3d64fc8a3bb384b7a5d0562~mv2.png/v1/crop/x_0,y_125,w_1600,h_512/fill/w_1298,h_415,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/Charlotte-James-Welcome_LaurineBaillyPhotographe-54_websize_edited.png 1x, https://static.wixstatic.com/media/11d052_6b841334f3d64fc8a3bb384b7a5d0562~mv2.png/v1/crop/x_0,y_125,w_1600,h_512/fill/w_1600,h_512,al_c,q_90,enc_avif,quality_auto/Charlotte-James-Welcome_LaurineBaillyPhotographe-54_websize_edited.png 2x" id="img_comp-le8b37rc" src="https://static.wixstatic.com/media/11d052_6b841334f3d64fc8a3bb384b7a5d0562~mv2.png/v1/crop/x_0,y_125,w_1600,h_512/fill/w_1298,h_415,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/Charlotte-James-Welcome_LaurineBaillyPhotographe-54_websize_edited.png" alt="Charlotte-James-Welcome_LaurineBaillyPhotographe-54_websize_edited.png" style="object-fit:cover" class="gRkIq0 sFiSiq" width="1298" height="415"/></div></div><!--/$--><!--$--><div id="comp-le8b6vx0" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le8b6vx0 wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:35px; text-align:center;"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text"><span style="font-size:35px;" class="wixui-rich-text__text"><span class="color_11 wixui-rich-text__text">Create a wedding that reflects you</span></span></span></p></div><!--/$--><!--$--><div id="comp-le8b63r7" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le8b63r7 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:75px; text-align:center;"><span class="color_11 wixui-rich-text__text"><span style="font-size:75px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text">The domain</span></span></span></h1></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-le8bb5j3" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le8bb5j3 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:45px;"><span class="color_35 wixui-rich-text__text"><span style="font-size:45px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text">A multitude of spaces</span></span></span></h2></div><!--/$--><!--$--><div id="comp-le8bc2zf" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le8bc2zf wixui-rich-text" data-testid="richTextElement"><h3 class="font_3 wixui-rich-text__text" style="font-size:20px;"><span class="color_35 wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text">Create your event</span></span></span></span></h3></div><!--/$--><!--$--><div id="comp-le8bcn8b" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le8bcn8b wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:15px;"><span style="font-size:15px;" class="wixui-rich-text__text">Domaine de Valbonne is the ideal place to welcome your guests in a magical setting and amaze them for a whole weekend or an extended stay.</span></p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;"><span style="font-size:15px;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;"><span style="font-size:15px;" class="wixui-rich-text__text">A Provençal courtyard, in the heart of the forest, under the olive trees, by the water… we offer you the possibility of privatizing the place and creating endless configurations and layouts.</span></p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;"><span style="font-size:15px;" class="wixui-rich-text__text"><span class="wixGuard wixui-rich-text__text">​</span></span></p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;"><span style="font-size:15px;" class="wixui-rich-text__text">Our goal: to make you feel at home and provide you with a unique and personalized experience.</span></p></div><!--/$--><!--$--><div id="comp-le8bauky" class="W4V2qg comp-le8bauky wixui-image" title="Karma Stories"><div data-testid="linkElement" class="apPOZK"><img fetchpriority="high" sizes="729px" srcSet="https://static.wixstatic.com/media/11d052_3355fbf6e04c464ebab6d705ea706f21~mv2.jpg/v1/crop/x_0,y_100,w_5464,h_3440/fill/w_729,h_459,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/aerienne.jpg 1x, https://static.wixstatic.com/media/11d052_3355fbf6e04c464ebab6d705ea706f21~mv2.jpg/v1/crop/x_0,y_100,w_5464,h_3440/fill/w_1458,h_918,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/aerienne.jpg 2x" id="img_comp-le8bauky" src="https://static.wixstatic.com/media/11d052_3355fbf6e04c464ebab6d705ea706f21~mv2.jpg/v1/crop/x_0,y_100,w_5464,h_3440/fill/w_729,h_459,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/aerienne.jpg" alt="Valbonne Estate layout with accommodations and reception areas" style="object-fit:cover" class="gRkIq0 sFiSiq" width="729" height="459"/></div></div><!--/$--><div data-mesh-id="comp-le7ba9glinlineContent-wedge-3"></div></div></div></section><!--/$--><!--$--><section id="comp-lm7zhfkz" tabindex="-1" class="Le88gL comp-lm7zhfkz wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-lm7zhfkz" data-hook="bgLayers" data-motion-part="BG_LAYER comp-lm7zhfkz" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-lm7zhfkz" data-motion-part="BG_MEDIA comp-lm7zhfkz" class="ROWgFb"></div></div><div data-mesh-id="comp-lm7zhfkzinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-lm7zhfkzinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-lm7zivr5" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-lm7zivr5 wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="text-align:center; font-size:45px;"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:playfair-display-v2,serif;" class="wixui-rich-text__text"><span class="color_11 wixui-rich-text__text">Discover our estate with a Virtual Tour</span></span></span></h2></div><!--/$--><!--$--><div id="comp-ln2vnkfy" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-ln2vnkfy wixui-rich-text" data-testid="richTextElement"><h3 class="font_3 wixui-rich-text__text" style="font-size:20px; text-align:center;"><span class="color_11 wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text">Watch our presentation video then take a virtual walk around our estate</span></span></h3></div><!--/$--><!--$--><div id="comp-ln3kkez8" class="W4V2qg comp-ln3kkez8 wixui-image cs40a3"><a data-testid="linkElement" href="https://visite.domainedevalbonne.com" target="_blank" rel="noopener" class="apPOZK"><img loading="lazy" sizes="317px" srcSet="https://static.wixstatic.com/media/11d052_a0279b2bfc03400ab19421382ea32535~mv2.png/v1/fill/w_317,h_108,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Vue%20par%20drone.png 1x, https://static.wixstatic.com/media/11d052_a0279b2bfc03400ab19421382ea32535~mv2.png/v1/fill/w_634,h_216,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Vue%20par%20drone.png 2x" id="img_comp-ln3kkez8" src="https://static.wixstatic.com/media/11d052_a0279b2bfc03400ab19421382ea32535~mv2.png/v1/fill/w_317,h_108,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Vue%20par%20drone.png" alt="Virtual tour of the Domaine de Valbonne in Provence" style="object-fit:cover" class="gRkIq0 sFiSiq" width="317" height="108"/></a></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-le8bfy40" tabindex="-1" class="Le88gL comp-le8bfy40 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-le8bfy40" data-hook="bgLayers" data-motion-part="BG_LAYER comp-le8bfy40" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-le8bfy40" data-motion-part="BG_MEDIA comp-le8bfy40" class="ROWgFb"></div></div><div data-mesh-id="comp-le8bfy40inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-le8bfy40inlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le8bgd47" class="comp-le8bgd47 wixui-vector-image"><div data-testid="svgRoot-comp-le8bgd47" class="iL7Pq5 gx51wo"><svg preserveAspectRatio="none" data-bbox="17.3 68.2 165.3 63.6" xmlns="http://www.w3.org/2000/svg" viewBox="17.3 68.2 165.3 63.6" role="presentation" aria-hidden="true">
    <g>
