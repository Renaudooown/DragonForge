Q7kNvwESsPsa&_nc_oc=AdrivX4fOCnZeeYL7ZIpPmvuqiOtYQtywpgAJlpXHEC8QEx1hMSzAV_DT-gM31wXiYE&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJCowcAssf1XfwZlI-N4MTQgf_z4sonyzed19gT1MmREgTZbcSJ0myMcwZ6D8eIDhX3lI18CYSc&oh=00_AQIXDjiS9uJabsjMNNU4rtypy4Rj_hhhrKAIft7PYM4Sow&oe=6AAA581E"},{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/489956499_18056875634132449_4018446836194765816_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=108&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=Zh4pdLDa5FUQ7kNvwE11clS&_nc_oc=Adokeoei6dDxczpQX5bWAIb6TMdt4_VdOu_B84_UGWOwsJq7jBmsUUSqUpH-1E54kCo&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQKmwXa8fqcqv4vX7m2PgTWTHVJ0PHkXf-yZUgzbPMH6ULOvoHmsIUZ7xkvc_1asNtHCIRhMczu1&oh=00_AQJXI57XxHKqDL44fTocXO3KZjJ2JCiasGyO9CmD2Pposg&oe=6AAA3904"}],"width":218,"height":218},{"type":"carousel","description":"Le Domaine de Valbonne en Provence se redécouvre sous un nouveau jour...\nGrâce aux avancées technologiques, les paysages et le patrimoine du domaine prennent une toute nouvelle dimension, mêlant tradition et innovation. On adore cette atmosphère et ces tons chaleureux ❤️\n\nThe Domaine de Valbonne in Provence is being rediscovered in a new light... \nThanks to technological advancements, the landscapes and heritage of the estate take on a whole new dimension, blending tradition and innovation. We love this warm atmosphere ❤️\n\n#domainedevalbonne #provence #wedding #innovationvisuelle #nouvellesimages #IA #photographiecréative #drones #histoireetfutur #weddingidea #weddingatmosphere #dinerunderthestars #semarierenprovence #saintpauletdecaisson #gard","alt":"Le Domaine de Valbonne en Provence se redécouvre sous un nouveau jour...\nGrâce aux avancées technologiques, les paysages et le patrimoine du domaine prennent une toute nouvelle dimension, mêlant tradition et innovation. On adore cette atmosphère et ces tons chaleureux ❤️\n\nThe Domaine de Valbonne in Provence is being rediscovered in a new light... \nThanks to technological advancements, the landscapes and heritage of the estate take on a whole new dimension, blending tradition and innovation. We love this warm atmosphere ❤️\n\n#domainedevalbonne #provence #wedding #innovationvisuelle #nouvellesimages #IA #photographiecréative #drones #histoireetfutur #weddingidea #weddingatmosphere #dinerunderthestars #semarierenprovence #saintpauletdecaisson #gard","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/487879623_18056012174132449_2853906836019624970_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=k6_nmfAeG-wQ7kNvwFMvF_K&_nc_oc=AdrLJ5X8A7Oibs9Aq7JVGPcAJP7pALQ7bBojf0o4UhVPrLHUW6rwjGq1Pmq3X1JZ1ZQ&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQI3HE1IaJwlWIK8vzJ26ExeKrLPBhJLY8V6HpXubBxklqHpl8lmNe0baAQQRxhh_yX198rANRbR&oh=00_AQJ9e3ETdVMK0YHQKF0dB9tn6R2yXCleH_epcfxeTIqDIg&oe=6AAA5D60","link":"https:\/\/www.instagram.com\/p\/DH3nj7SIJv5\/","timestamp":"2025-03-31T15:38:22.000Z","children":[{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/487879623_18056012174132449_2853906836019624970_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=k6_nmfAeG-wQ7kNvwFMvF_K&_nc_oc=AdrLJ5X8A7Oibs9Aq7JVGPcAJP7pALQ7bBojf0o4UhVPrLHUW6rwjGq1Pmq3X1JZ1ZQ&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQK-09d2uWOL5kck6p4lv_LIzPT8SEw249YMxOeOlvbJqpQK1mA_9xhfF-hDJOji1o1k4y1xRf_x&oh=00_AQLV6EW3ctuNGvWo3TCRcYCpEjPMFSzHW-qA-OMSdo2FMw&oe=6AAA5D60"},{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/487624417_18056012183132449_8871834605064083193_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=109&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=5T0bZnP3ztsQ7kNvwGTmomS&_nc_oc=Adppeucvbu8cAPYNpV78lBx4gbvtdOhqWoWDhqI-2w-cc6mPM97hjWz1GpEYbd--0J0&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQLqzsegv3T90ur2nPty_mgey3-NPLaYRHaPyBTGeWPSirFhM7DfbbS91sT3VFM6ieJOq1NkCRaK&oh=00_AQLx2MGgtAyPP8iijonOh39yE1miioihLQfnl3yCCPQvvQ&oe=6AAA55D0"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/487955176_18056012162132449_2038360778274141199_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=PLz885kkdWYQ7kNvwEVpOco&_nc_oc=AdpVx-yvyywWN48xOL4FklxFrLnyVY0upnvw1qHUiXedz6oiO757cT_STS6lWWHfGww&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQKIFlHKzjJ6Jt4j0VlDxk48__ClweI3zuGxRKtNXaBT88Z3ntGHZqcqupELQHIDhprxX-tePJgI&oh=00_AQJ_hJ2ZtPczZoznvwAM0UuZ7HtXQXzXVRxaSRmBBd7YJQ&oe=6AAA3D73"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/487446173_18056012186132449_3472107979027282158_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=eZRCfvpsFu0Q7kNvwF--yQv&_nc_oc=Adr_d11qmrCM7iMh8fKOSKkJ6g2oMOa4OtOIy0Dw5V7lJEqQari5ulLNRuRGNBwjZjo&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQLbuayaTcVslZrlRjalFnU5_c97f4P59y17vURghAUQa7d2N7aTKzQQTK20oeGb37AUqC1r3FQL&oh=00_AQINzAxd9q8b8wUi9mjw81uj1DzHvA0DxGJfRDFMZM0ICQ&oe=6AAA6DD0"},{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/487779482_18056012198132449_7352951552583392825_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=kgD5dml2pK8Q7kNvwFMvV6U&_nc_oc=AdoPZ9WIivFjHvuDo7cEL6OesBUNmcxl-NsUKT6YUvFtVZn_ExS17nSoWk4q_BugZSQ&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJyGuChRq-Ljoe7AmB3LzC--qKcT9eSCiz2XJlcO6RSDE-_X1thMjus8MCecI-Qic8FVhIZXvOL&oh=00_AQIFw-129WmTC9TUiC0Mld_Guf5IZl4iWrdEdlFTkwEsWw&oe=6AAA6FC4"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/487873579_18056012189132449_3951551213852572769_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=103&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=CAJaAEZ9D8cQ7kNvwH1T8Cr&_nc_oc=AdpJNoFZQa4zL9XDwpuZiy1AeXqWUYaNPZ_10sfU1gZipfyFxVAoLvo8YvaSR-J8DmE&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQIQUzZZ48YUU3BhnUicxMvRR_aFspivmFFR7P7s9o9u1Uo2MSwVzGhCmORq8ZoJ_CSI1tRJ6YiP&oh=00_AQKxtd7PGJfcP9qFp0tnstIfciUn0hF9Ix65FI7VHxRTtA&oe=6AAA69E8"}],"width":218,"height":218},{"type":"carousel","description":"Un mariage entre élégance et éclats de rire ...\n\nParce qu’un mariage, c’est avant tout une histoire d’amour… mais aussi des fous rires, des instants volés et une ambiance inoubliable ! 💛\n\nEntre une danse improvisée sous les oliviers, des baisers volés au coucher du soleil et un soupçon de folie, M&A ont su créer le mariage de leur rêve.\n\nMerci à vous d’avoir rendu ce moment si magique. C’est pour des instants comme ceux-ci que nous aimons tant faire vivre notre domaine et donner du sens à notre projet.✨🥂\n\nA wedding between elegance and laughter...\n\nBecause a wedding is, above all, a love story… but also bursts of laughter, stolen moments, and an unforgettable atmosphere! 💛\n\nBetween an impromptu dance under the olive trees, stolen kisses at sunset, and a touch of madness, M&A created the wedding of their dreams.\n\nThank you for making this moment so magical. It is for moments like these that we love bringing our estate to life and giving meaning to our project. ✨🥂\n\nDomaine @domainedevalbonne \nWedding planner @mlj_events_\nConciergerie @conciergerielaclefdutemps\nTraiteur @lavallerguetraiteur \nPhotographe @mdclicstudio \nVidéaste @wedding_by_shivado\nDj @nuitblanchedj \nMaquilleuse\/coiffeuse @alwinenogier \nMaquilleuse\/coiffeuse @margotvoisin_muah \nFleuriste @les_herbes_sauvages\n\n#weddingmood #domainedevalbonne #amouretfolie #provencewedding \n#mariageenprovence #mariageelegant \n#olivierlovers #goldenhourlove #weddingunderthesun #romanceinprovence #provencevibes \n#natureloverwedding #elegantwedding #sunsetkiss #southoffrancewedding \n#bohoweddingvibes","alt":"Un mariage entre élégance et éclats de rire ...\n\nParce qu’un mariage, c’est avant tout une histoire d’amour… mais aussi des fous rires, des instants volés et une ambiance inoubliable ! 💛\n\nEntre une danse improvisée sous les oliviers, des baisers volés au coucher du soleil et un soupçon de folie, M&A ont su créer le mariage de leur rêve.\n\nMerci à vous d’avoir rendu ce moment si magique. C’est pour des instants comme ceux-ci que nous aimons tant faire vivre notre domaine et donner du sens à notre projet.✨🥂\n\nA wedding between elegance and laughter...\n\nBecause a wedding is, above all, a love story… but also bursts of laughter, stolen moments, and an unforgettable atmosphere! 💛\n\nBetween an impromptu dance under the olive trees, stolen kisses at sunset, and a touch of madness, M&A created the wedding of their dreams.\n\nThank you for making this moment so magical. It is for moments like these that we love bringing our estate to life and giving meaning to our project. ✨🥂\n\nDomaine @domainedevalbonne \nWedding planner @mlj_events_\nConciergerie @conciergerielaclefdutemps\nTraiteur @lavallerguetraiteur \nPhotographe @mdclicstudio \nVidéaste @wedding_by_shivado\nDj @nuitblanchedj \nMaquilleuse\/coiffeuse @alwinenogier \nMaquilleuse\/coiffeuse @margotvoisin_muah \nFleuriste @les_herbes_sauvages\n\n#weddingmood #domainedevalbonne #amouretfolie #provencewedding \n#mariageenprovence #mariageelegant \n#olivierlovers #goldenhourlove #weddingunderthesun #romanceinprovence #provencevibes \n#natureloverwedding #elegantwedding #sunsetkiss #southoffrancewedding \n#bohoweddingvibes","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/482626066_18053290016132449_4696601365649094923_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=RPeS2zYNNVIQ7kNvwGXBBOf&_nc_oc=AdpuJNcVB3k8LpxeCelFmeAPccqiMoF2ApGhpgTHV3mpKnpDKYmNZxd9jKlnowB-Pb4&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQKVDhUbcCqfZC7ZzovaNieZQ0T2HGtKjgRFpDeE-sJ8UJlPQT7K6Pfb8MrSkq3JHklOxBTKkL0e&oh=00_AQJddPyO5tLSkKvaYBddNtWtsCn9yToty4RSftrD5B27hw&oe=6AAA39A1","link":"https:\/\/www.instagram.com\/p\/DGtENIuojaE\/","timestamp":"2025-03-02T16:45:38.000Z","children":[{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/482626066_18053290016132449_4696601365649094923_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=RPeS2zYNNVIQ7kNvwGXBBOf&_nc_oc=AdpuJNcVB3k8LpxeCelFmeAPccqiMoF2ApGhpgTHV3mpKnpDKYmNZxd9jKlnowB-Pb4&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQKtAAoADcm4HoKiNLc5PPvSXRA5YTrgm8uns0O6Cc21vXA0C7gCBO9ixQ7u_UtgGf18x3HVHrhf&oh=00_AQJHEyLnLGvf7Yqsqe4o_IUp_DQmxg2kWzaKeUfo53tSOw&oe=6AAA39A1"},{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/482180118_18053290004132449_8799955851073806465_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=108&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=J8-2tWfb_O0Q7kNvwF9rjYf&_nc_oc=AdpiJGZbzWJK2-56wTfCm_J49J7fBCJE1TQQb_1KaQkg8Az7gm9n7fM_yzI2eT0kjyw&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQIqzptKOtrOsO6zlSqA6r1BoFOzPDdly8BrqwaATAIC6szBbsXVzEJU5tX_mPg485U-qaGFgBd7&oh=00_AQK-Ij-BkdE31hIYJeR2opYVzkYNFh7oGHVgNiiRLfWidg&oe=6AAA6CD0"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/482318009_18053290007132449_6817258293830715215_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=3_eK5GxhVW8Q7kNvwGfdK5E&_nc_oc=AdroZXRv5L1Q-9LuPEh1SF7cUkblNEJrgNtL984-f00E3N_KKl1SN-7gc7DwMj3tKfM&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQKlntu6oFfdEiiHM40M7TumPSPTBNC9FV-VGeh4QCwg_uVGLV_aac9cubW3PA4eJcI9JVvJKgVS&oh=00_AQIs4u4p8DFkzFiyYmEuguxp6vbI7vQUH--dtgPxHLh4Hw&oe=6AAA5876"}],"width":218,"height":218},{"type":"image","description":"Bonne Saint-Valentin à tous les amoureux ! ❤️\n\nOn vous souhaite plein de sourires, de câlins et de beaux moments à deux.\nProfitez de ce moment pour dire « je t'aime » un peu plus fort. \n\nAvec tout notre amour,\nLe Domaine de Valbonne\n\n#saintvalentin #amour #love #domainedevalbonne #journéedesamoureux #bonnesaintvalentin \n\nHappy Valentine’s Day to all the lovers! ❤️\n\nWishing you smiles, hugs, and beautiful moments together.\nTake this time to say “I love you” a little louder.\n\nWith all our love,\nLe Domaine de Valbonne\n\n#valentinesday #love #romance #domainedevalbonne #dayoflove #happyvalentinesday \n\nPhotographe @laurineblly","alt":"Bonne Saint-Valentin à tous les amoureux ! ❤️\n\nOn vous souhaite plein de sourires, de câlins et de beaux moments à deux.\nProfitez de ce moment pour dire « je t'aime » un peu plus fort. \n\nAvec tout notre amour,\nLe Domaine de Valbonne\n\n#saintvalentin #amour #love #domainedevalbonne #journéedesamoureux #bonnesaintvalentin \n\nHappy Valentine’s Day to all the lovers! ❤️\n\nWishing you smiles, hugs, and beautiful moments together.\nTake this time to say “I love you” a little louder.\n\nWith all our love,\nLe Domaine de Valbonne\n\n#valentinesday #love #romance #domainedevalbonne #dayoflove #happyvalentinesday \n\nPhotographe @laurineblly","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/479365236_18051684707132449_6905012370936743474_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=110&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=oVNumitiUxIQ7kNvwFXfZNK&_nc_oc=AdqN58G14DBWWHHugCWjqXGj-Eo_iAiAqEFf8GNTF4Zv-4x26MFiU0r8JS1j-AYeX38&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJgP72X-6JudvoJcrZ3W42jNbQI4CZ3rCYcM9pMAiPcS6pj55kdTJULhSt-UVKH-Bq6jkswh-t3&oh=00_AQJxkj-Vf9ES6sLnqivBZzYes98XFdGm4IKj4aSRUq9K8w&oe=6AAA45DA","link":"https:\/\/www.instagram.com\/p\/DGD6L-6Iao-\/","timestamp":"2025-02-14T17:09:14.000Z","width":218,"height":218},{"type":"carousel","description":"Souvenir d’un magnifique mariage d’été au domaine\n\nUn cadre enchanteur, une douce lumière dorée, et une organisation impeccable signée Marjorie de @agence_suzetteetsimone ! Chaque détail était pensé avec soin pour une journée parfaite. Quel bonheur…\n\nMerci infiniment aux mariés et à leurs proches pour leur confiance, leur énergie et ces merveilleux moments partagés. Votre complicité et votre amour ont illuminé cette journée.\n\nHâte de recevoir nos futurs mariés 2025, on compte les jours avant de partager ces beaux moments à vos côtés.\n\nA memory of a beautiful summer wedding at the Domaine\n\nAn enchanting setting, soft golden light, and flawless organization by Marjorie from @agence_suzetteetsimone ! Every detail was carefully thought out for a perfect day. Pure joy…\n\nA huge thank you to the couple and their loved ones for their trust, energy, and the wonderful moments we shared. Your bond and love lit up this day.\n\nWe can’t wait to welcome our 2025 couples — counting the days until we can share these beautiful moments with you. \n\nWedding Planner @agence_suzetteetsimone \nPhotographe @anais_bizet_photographie \nFleuriste @alkonost_fleurs \nMake up @unbrindaudace \nSaxo @emiliedlf \nTraiteur @maison_nans \nDJ @le_bac_a_vinyles \nLocation mobilier @raima_menestra @jani_solution_evenementielle \n\n#destinationweddingfrance #valbonneweddings #weddinginspiration #romanticweddingvenue #luxuryweddings #outdoorweddingdreams #weddingseason #loveinprovence #memorablemoments #saintpauletdecaisson #domainedevalbonne","alt":"Souvenir d’un magnifique mariage d’été au domaine\n\nUn cadre enchanteur, une douce lumière dorée, et une organisation impeccable signée Marjorie de @agence_suzetteetsimone ! Chaque détail était pensé avec soin pour une journée parfaite. Quel bonheur…\n\nMerci infiniment aux mariés et à leurs proches pour leur confiance, leur énergie et ces merveilleux moments partagés. Votre complicité et votre amour ont illuminé cette journée.\n\nHâte de recevoir nos futurs mariés 2025, on compte les jours avant de partager ces beaux moments à vos côtés.\n\nA memory of a beautiful summer wedding at the Domaine\n\nAn enchanting setting, soft golden light, and flawless organization by Marjorie from @agence_suzetteetsimone ! Every detail was carefully thought out for a perfect day. Pure joy…\n\nA huge thank you to the couple and their loved ones for their trust, energy, and the wonderful moments we shared. Your bond and love lit up this day.\n\nWe can’t wait to welcome our 2025 couples — counting the days until we can share these beautiful moments with you. \n\nWedding Planner @agence_suzetteetsimone \nPhotographe @anais_bizet_photographie \nFleuriste @alkonost_fleurs \nMake up @unbrindaudace \nSaxo @emiliedlf \nTraiteur @maison_nans \nDJ @le_bac_a_vinyles \nLocation mobilier @raima_menestra @jani_solution_evenementielle \n\n#destinationweddingfrance #valbonneweddings #weddinginspiration #romanticweddingvenue #luxuryweddings #outdoorweddingdreams #weddingseason #loveinprovence #memorablemoments #saintpauletdecaisson #domainedevalbonne","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/476253972_18050774108132449_3429971824841059050_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=SDMi0DXVyDMQ7kNvwG9wQJC&_nc_oc=AdqXyxuq8deCmSsT4IgRYXcDtzM3qUGgUketlR0XD8FnWQIC5yZz3GlchTeGEG1vOyI&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQK4bn4Q3qqLJyzR4tZoghGJ7RG7cXrjUWMCtEvaLGRo8wGxgFWWNdL1VdY0KlBQVbs1k8lAVCdb&oh=00_AQK0KBVmT12M4aanNuInmYZFTEc_9Kulu2iOYKSzjl15pQ&oe=6AAA436F","link":"https:\/\/www.instagram.com\/p\/DFsGLy1oLJA\/","timestamp":"2025-02-05T11:12:17.000Z","children":[{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/476253972_18050774108132449_3429971824841059050_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=SDMi0DXVyDMQ7kNvwG9wQJC&_nc_oc=AdqXyxuq8deCmSsT4IgRYXcDtzM3qUGgUketlR0XD8FnWQIC5yZz3GlchTeGEG1vOyI&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJoxQxHE8zvX9mAY3578B8x-px8DIyzQ968gG8YKLlUtJw5NrJONRSE7GjJxEuzLuNyQmWYywJC&oh=00_AQJWWkdrpcHt6wc4PoBg7fFgz0w3fR3k1q_r0_Tj5vLb2w&oe=6AAA436F"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/476308969_18050774114132449_5223562130322380827_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=5-OJ9H6M7kQQ7kNvwE_mqrv&_nc_oc=AdpccosSwZEPBzdBqQnqxiGqykKYISOSjk6Snq4tBCaOMgr3bxurOBzZw8QSZEvT27Y&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJWMiQyBkgpvcyXurOSOV96shx7bVNVRYXGkehk7sv9YxNcihZTY_kTDP-62iPRu9SFceEqYY9w&oh=00_AQJ_vnUf2lwXpGAl15GnAgO95kPk1aV7w-gQy4nsoDyoSw&oe=6AAA4CCE"},{"type":"image","src":"https:\/\/instagram.ftlv23-1.fna.fbcdn.net\/v\/t51.75761-15\/475865342_18050774096132449_6627720415547357322_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=111&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=4-W-vXyfh0AQ7kNvwFgpizG&_nc_oc=AdqSLnMuxQcLUmOFQI2_G2R7b4uhX0Y4I4QC4hFhRFA09AQSd-sbR_EZVmu0zFtjbc4&_nc_zt=23&_nc_ht=instagram.ftlv23-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQJbg4B5VP-nMUQRvWzMJFCCHmHD-QnEkmgLgNAdsoDIedI1p9mypNVop3PZoBal_L71r7bwgYTL&oh=00_AQL_5nLQ4WpqVBJn5klQcpr0TsEEVLkXUrX8AmPyoP0MLQ&oe=6AAA3FD8"},{"type":"image","src":"https:\/\/instagram.fsdv2-1.fna.fbcdn.net\/v\/t51.75761-15\/476317541_18050774087132449_2736984805739877329_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=103&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=Yliir2zKTiQQ7kNvwH1KzA9&_nc_oc=Ado3YaxrpkNuTEwahU5_As0DrYmWCxWLhAJ3rrgikE8ckc-HpJDS6A3a7xuzuUtGncg&_nc_zt=23&_nc_ht=instagram.fsdv2-1.fna&edm=ANo9K5cEAAAA&_nc_gid=Sr1fiQKatDeYfrPUmA3DGw&_nc_tpa=Q5bMBQI5XZauambOrzrEI-MtPZUhFD_JH5i6V8t1cr8nQa1bUWkGWjxBmrO8snGMPgU9_M6vWKtor0dJ&oh=00_AQKOXlCYLUenUPVFBheLCKEkVb1LJhtSAqlNQl4h2bEI5w&oe=6AAA538B"}],"width":218,"height":218}],"itemsSrc":"wixSDK","isExternalPagination":true},"comp-m4vgnff3_r_comp-lqwd66ma_r_comp-lqwctm3h":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixGuard\">&#8203;<\/span><\/h2>"},"comp-m4vgnff3_r_comp-lqwd66ma_r_comp-lqwcu1sz":{"html":"<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixGuard\">&#8203;<\/span><\/p>"},"comp-le8bi5ho":{"height":683,"width":1024,"fallbackTitle":"MariageCamilleetVincent-00562-POP08449 (2).jpg","uri":"11d052_404eacf5282c4c5082185a33e0aa3e9b~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"Lavenders","title":"Ben Levy"},"comp-le8bkgbp":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">Lavender<\/span><\/span><\/span><\/h2>"},"comp-le8bl0hi":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">Lavender fields and the song of cicadas perfectly symbolize the magic of Provence.<br>Your wedding memories will remain etched in your mind forever, and what could be more romantic than having your photo taken in the heart of the lavender fields at Domaine de Valbonne?<br><br>Don&#39;t miss this enchanting setting during the famous “golden hour,” when the golden evening light enhances every moment and transforms your wedding photos in Provence into true natural works of art.<\/span><\/p>"},"comp-le8bw2t9":{"height":683,"width":1024,"fallbackTitle":"MariageMarie+Stéphane-00073-BL108111.jpg","uri":"314229_6e84f1d7cb2a41e5ba80b9eb295516e1~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The shaded expanse","title":"Ben Levy"},"comp-le8bwkqr":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The shady plain<\/span><\/span><\/span><\/h2>"},"comp-le8bxeao":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">This space surrounded by nature gives free rein to your imagination to create the setting of your dreams.<br>Under the gigantic holm oaks, imagine a secular ceremony full of emotion, a dinner under the stars or in an elegant nomadic tent, or even a brunch the next day in the heart of a natural setting steeped in history.<br>These century-old trees watch over your most precious moments.<br><br>And to prolong the spirit of the south, don&#39;t miss the unmissable pétanque area—a place of typical Provençal conviviality, in the natural shade of the trees or under the guinguette lights at dusk.<br>A joyful and unifying moment, filled with laughter, relaxation, and friendly competition... So, are you shooting or pointing?<\/span><\/p>"},"comp-le8d5zmc":{"height":1908,"width":4032,"fallbackTitle":"clairiere.jpg","uri":"314229_809d4b0d92854ff7b65b55b73c37fe3a~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The meadow","title":"Valbonne Estate"},"comp-le8d5zmv":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The clearing<\/span><\/span><\/span><\/h2>"},"comp-le8d5zmx1":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">This natural space is highly prized in Provence for its coolness and unique play of light.<br><br>In the clearing, along the Canet stream, which has been restored to its former glory, you can freely imagine your own decorations and arrangements: a secular ceremony or a country brunch in the shade of century-old oak trees, arbutus trees, or laurels.<br>A peaceful and enchanting setting that leaves no one indifferent.<\/span><\/p>"},"comp-le8db5cz":{"height":1365,"width":2048,"fallbackTitle":"MariageEllieetJack_-4 (1).jpg","uri":"11d052_26ccb733c9814cc7bde8bf4493b1e2d0~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The swimming pool area","title":"Karma Stories"},"comp-le8db5c9":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">Pool area<\/span><\/span><\/span><\/h2>"},"comp-le8db5cd":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">The cocktail reception or wine reception takes place around the estate&#39;s swimming pool, a 13 x 7 meter heated pool surrounded by spacious terraces, a travertine and wood bar, and elegant lounge areas.<br><br>Located on the elevated part of the Domaine de Valbonne, this space offers your guests a breathtaking view of the historic building and the typical Provencal landscape: vineyards, lavender fields, and olive trees as far as the eye can see.<br>A refined and soothing setting, ideal for a cocktail at sunset or a relaxed brunch.<\/span><\/p>"},"comp-le8dkw53":{"height":1365,"width":2048,"fallbackTitle":"daphné-et-valentin-130.jpg","uri":"11d052_f302aef5de2c4c05a3bc226704cac134~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The village courtyard","title":"Anais Bizet"},"comp-le8dkw5o":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The village courtyard<\/span><\/span><\/span><\/h2>"},"comp-le8dkw5r1":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">Under the glow of fairy lights, your wedding dinner in Provence will be transformed into a magical evening under the stars, in a friendly and elegant atmosphere.<br><br>And because charm doesn&#39;t depend on the weather, a custom-made canopy can be installed to protect your guests without altering the authentic spirit of the venue.<\/span><\/p>"},"comp-lgjjbxgn":{"height":576,"width":1024,"fallbackTitle":"155-BTSLindaValbonne-ZephyrKokPhotography (1).jpg","uri":"11d052_82a0346c5c544fda882442cdb4b65803~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The olive trees","title":"Neupap photography"},"comp-lgjjbxg3":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">Olive trees<\/span><\/span><\/span><\/h2>"},"comp-lgjjbxg7":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">Organize your intimate wedding ceremony or reception in the heart of the olive groves at Domaine de Valbonne, in a peaceful atmosphere bathed in light.<br>Under the silvery branches of these century-old trees, your guests will enjoy a natural and authentic setting, typical of Provence.<br>Appropriate lighting is essential to enhance this space: luminous skies or curtains of light highlight the trees and create a magical atmosphere once night falls.<br>A place that combines elegance, nature, and conviviality, perfect for prolonging the magic of your wedding in Provence.<br>An iconic tree of the south of France, the olive tree embodies peace, honor, and immortality—symbols that echo the promise of eternal love.<\/span><\/p>"},"comp-lf5r1ffl":{"height":2667,"width":4000,"fallbackTitle":"SA-190725-valbonne-elielle-hd-769 (1).jpg","uri":"11d052_b2a8bc8ff42f48e7a845655ba7977863~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The dance hall","title":"Eli Elle"},"comp-lf5r1ffw":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The dance floor<\/span><\/span><\/span><\/h2>"},"comp-lf5r1ffz":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">Opposite the courtyard of the Domaine de Valbonne, a 1,000-square-foot barn, completely renovated and air-conditioned, provides the perfect setting for your dance floor and musical evening, with breathtaking views of olive trees and lavender fields.<br><br>Its blend of stone, glass, and wrought iron, enhanced by sparkling mirror balls and a cozy night bar, creates an elegant and refined party atmosphere, perfect for extending the evening into the night.Let the dancing begin!<br><br>At the entrance to the estate, this magnificent Provençal barn can also be transformed into a charming setting for a secular ceremony or a romantic dinner, offering a sumptuous view of the Provençal countryside.<\/span><\/p>"},"comp-lf5rcz51":{"height":3413,"width":6068,"fallbackTitle":"caves voutées.jpg","uri":"11d052_9e6d68d42fdc424db3ef1fb00bbd69df~mv2.jpg","crop":null,"responsiveImageProps":null,"alt":"The vaulted space","title":"Valbonne Estate"},"comp-lf5rcz4p":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The vaulted space<\/span><\/span><\/span><\/h2>"},"comp-lf5rcz4s":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">Facing the courtyard of the Domaine de Valbonne, 1,200 square feet of magnificent vaulted cellars have been completely restored.<br>The charm of exposed stonework, the natural coolness of period walls, and wrought-iron windows create an authentic and intimate atmosphere, enhanced by a bright starry sky that illuminates the vaulted ceiling with a thousand reflections.<br><br>A magical space to host your dinner, ceremony, or cocktail party, even in case of rain or wind.<\/span><\/p>"},"comp-lf5rg3nm":{"height":1170,"width":1494,"fallbackTitle":"vieillegrange.png","uri":"314229_c5bc6ab27d8b43e3bd4098c5274112b0~mv2.png","crop":null,"responsiveImageProps":null,"alt":"The old barn","title":"Valbonne Estate"},"comp-lf5r3kdy":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">The old barn<\/span><\/span><\/span><\/h2>"},"comp-lf5r3ke1":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">At the entrance to the Domaine de Valbonne stands an old Provençal stone barn measuring 90 m², preserved in all its authenticity.<br>Its exposed stonework and wooden beams make it a charming space, ideal for hosting your wedding ceremony, an intimate cocktail party, or a sheltered brunch in case of rain or mistral winds.<\/span><\/p>"},"comp-lgjjcimu":{"height":306,"width":480,"fallbackTitle":"photoDV-480x306.webp","uri":"314229_a5c45102eaad460ca884a26c3a65b78e~mv2.webp","crop":null,"responsiveImageProps":null,"alt":"The professional area"},"comp-lgjjcimm":{"html":"<h2 class=\"font_2 wixui-rich-text__text\" style=\"font-size:45px;\"><span class=\"color_35 wixui-rich-text__text\"><span style=\"font-size:45px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:playfair display,serif;\" class=\"wixui-rich-text__text\">Pro area<\/span><\/span><\/span><\/h2>"},"comp-lgjjcimo":{"html":"<p class=\"font_7 wixui-rich-text__text\" style=\"font-size:15px;\"><span style=\"font-size:15px;\" class=\"wixui-rich-text__text\">At Domaine de Valbonne, we pay particular attention to the satisfaction of your service providers.<br>Because happy teams make for happy newlyweds and guests, we do everything we can to offer them the best working conditions.<br><br>The Domaine has rare, high-end facilities for your caterer and event teams:<br>a large, fully equipped professional kitchen, a cold room, an ice machine, and a 90 m² preparation room where plates can be prepared simultaneously so that all your guests can enjoy smooth service and a perfect dinner.<br><br>Everything is in place to guarantee a successful and delicious wedding reception in the heart of Provence.<\/span><\/p>"},"comp-m4vgnff3_r_comp-luph70yy":{"collapsed":false},"comp-m4vgnff3_r_comp-luph9qg83":{"label":"@domainedevalbonne","link":{"type":"ExternalLink","href":"https:\/\/www.instagram.com\/domainedevalbonne","target":"_blank","rel":"noopener"}},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mrvxbslm":{"src":""},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz52sda":{"html":"<h2 class=\"font_2 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">domainedevalbonne<\/span><\/h2>"},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz568m4":{"collapsed":true},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz568ld":{"collapsed":true},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz545vu10__posts":{"html":"<p class=\"font_8 wixui-rich-text__text\">0 posts<\/p>"},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz545vu10__followers":{"html":"<p class=\"font_8 wixui-rich-text__text\">0 followers<\/p>"},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz545vu10__following":{"html":"<p class=\"font_8 wixui-rich-text__text\">0 following<\/p>"}}],"ssrStyleUpdates":[{"comp-m4vgnff3_r_comp-m010jxj2":{"visibility":"hidden !important","overflow":"clip !important","height":"0 !important","width":"0 !important","min-width":"0 !important","min-height":"0 !important","margin-bottom":"0 !important","margin-left":"0 !important","margin-right":"0 !important","padding":"0 !important","position":"absolute !important","margin-top":"0 !important"},"comp-m4vgnff3_r_comp-mqz5ispp_r_comp-mqz568m4":{"visibility":"hidden !important","overflow":"clip !important","height":"0 !important","width":"0 !important","min-width":"0 !important","min-height":"0 !important","margin-bottom":"0 !important","margin-left":"0 !important","margin-right":"0 !important","padding":"0 !important","position":"absolute !important","margin-top":"0 !important"},"comp-m4vgnf