g1eop_wrapper":"PageMountUnmount","g1eop_wrapper_background":"PageMountUnmount"}},"appsWarmupData":{"dataBinding":{"schemas":{"Ledomaine":{"id":"Ledomaine","isDeleted":false,"namespace":null,"storage":"docstore","ownerAppId":null,"displayNamespace":null,"displayField":"title","allowedOperations":["patch","isReferenced","insert","save","bulkInsert","bulkUpdate","update","truncate","remove","removeReference","count","bulkPatch","find","replaceReferences","bulkRemove","insertReference","get","bulkSave","queryReferenced","distinct","aggregate"],"collectionOperations":["update","remove"],"fields":{"title":{"displayName":"Title","systemField":false,"sortable":true,"isDeleted":false,"index":0,"type":"text","plugins":{}},"_id":{"displayName":"ID","systemField":true,"sortable":true,"isDeleted":false,"index":1,"type":"text","plugins":{}},"_createdDate":{"displayName":"Created Date","systemField":true,"sortable":true,"isDeleted":false,"index":2,"type":"datetime","plugins":{}},"_updatedDate":{"displayName":"Updated Date","systemField":true,"sortable":true,"isDeleted":false,"index":3,"type":"datetime","plugins":{}},"_owner":{"displayName":"Owner","systemField":true,"sortable":true,"isDeleted":false,"index":4,"type":"text","plugins":{}},"id":{"displayName":"ID","systemField":false,"sortable":true,"isDeleted":false,"index":5,"type":"number","plugins":{}},"description":{"displayName":"Description","systemField":false,"sortable":true,"isDeleted":false,"index":6,"type":"text","plugins":{}},"image":{"displayName":"Image","systemField":false,"sortable":true,"isDeleted":false,"index":7,"type":"image","plugins":{}},"photo":{"displayName":"Photo","systemField":false,"sortable":true,"isDeleted":false,"index":8,"type":"text","plugins":{}},"title_en":{"displayName":"Title EN","systemField":false,"sortable":true,"isDeleted":false,"index":9,"type":"text","plugins":{}},"description_en":{"displayName":"Description EN","systemField":false,"sortable":true,"isDeleted":false,"index":10,"type":"text","plugins":{}}},"displayName":"Le domaine","defaultSort":null,"version":11,"plugins":{"multilingual":{"translatable":["photo","image","description","title_en","description_en","title"]},"persistentPageLink":{"isPersisted":true,"isUpdatable":true}},"pagingMode":["OFFSET","CURSOR"],"translatable":false,"ttl":null}},"dataStore":{"recordInfosByDatasetId":{"comp-lgjjeg9x":{"itemIds":["1a0aa6b7-76b2-415a-9260-0ed33cb4dc51"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjgkqk":{"itemIds":["b2747a4d-2dd8-47b1-8cfe-4f9f4880d5c3"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjjvub":{"itemIds":["47fbec0b-7132-4186-a0f5-4593dd810ee2"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjld5i":{"itemIds":["49ec722f-e8d4-4813-9c05-740664431e5d"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjmudq":{"itemIds":["1da763a9-3aa7-4f61-bf7d-c996e350f2ca"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjohhi":{"itemIds":["98a3b440-7f8f-49d9-826e-a883763b987f"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjq8qj":{"itemIds":["135caa65-24b6-42cf-964f-57a66969e68b"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjrv9r":{"itemIds":["22584002-4d95-4bdf-b9f4-670f0a80d027"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjurep":{"itemIds":["fb1112e9-9863-4148-a31f-111b2902b4e4"],"datasetSize":{"total":1,"loaded":1}},"comp-lgjjvsif":{"itemIds":["babc8fe6-a9b6-440a-96d0-86cbc6557b66"],"datasetSize":{"total":1,"loaded":1}}},"recordsByCollectionId":{"Ledomaine":{"1a0aa6b7-76b2-415a-9260-0ed33cb4dc51":{"photo":"Ben Levy","image":"wix:image:\/\/v1\/11d052_404eacf5282c4c5082185a33e0aa3e9b~mv2.jpg\/MariageCamilleetVincent-00562-POP08449%20(2).jpg#originWidth=1024&originHeight=683","description":"The lavender fields and the song of the cicadas perfectly symbolize the magic of Provence.\n\nYour wedding memories will be etched in your mind forever, and what could be more romantic than having your photos taken amidst the lavender fields of Domaine de Valbonne?\n\nDon't miss this enchanting setting during the famous \"golden hour,\" when the golden evening light enhances every moment and transforms your Provençal wedding photos into true works of art.","title_en":"Lavender","_id":"1a0aa6b7-76b2-415a-9260-0ed33cb4dc51","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:54:15.840Z"},"_updatedDate":{"$date":"2025-11-26T14:15:10.718Z"},"description_en":"Lavender fields and the song of cicadas perfectly symbolize the magic of Provence.\nYour wedding memories will remain etched in your mind forever, and what could be more romantic than having your photo taken in the heart of the lavender fields at Domaine de Valbonne?\n\nDon't miss this enchanting setting during the famous “golden hour,” when the golden evening light enhances every moment and transforms your wedding photos in Provence into true natural works of art.","id":1,"title":"Lavenders"},"b2747a4d-2dd8-47b1-8cfe-4f9f4880d5c3":{"photo":"Ben Levy","image":"wix:image:\/\/v1\/314229_6e84f1d7cb2a41e5ba80b9eb295516e1~mv2.jpg\/MariageMarie+St%C3%A9phane-00073-BL108111.jpg#originWidth=1024&originHeight=683","description":"This natural setting allows your imagination to run wild as you create the scene of your dreams.\nUnder the towering holm oaks, imagine a deeply moving secular ceremony, a dinner under the stars or in an elegant nomadic tent, or even a post-wedding brunch in the heart of a natural setting steeped in history.\nThese centuries-old trees watch over your most precious moments.\n\nAnd to extend the southern spirit, don't miss the unmissable pétanque area—a place of typically Provençal conviviality, in the natural shade of the trees or under the twinkling lights of a bistro at dusk. A joyful and unifying moment, filled with laughter, relaxation, and friendly competition… So, are you shooting or pointing?","title_en":"The shady plain","_id":"b2747a4d-2dd8-47b1-8cfe-4f9f4880d5c3","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:54:20.477Z"},"_updatedDate":{"$date":"2025-11-26T14:14:14.684Z"},"description_en":"This space surrounded by nature gives free rein to your imagination to create the setting of your dreams.\nUnder the gigantic holm oaks, imagine a secular ceremony full of emotion, a dinner under the stars or in an elegant nomadic tent, or even a brunch the next day in the heart of a natural setting steeped in history.\nThese century-old trees watch over your most precious moments.\n\nAnd to prolong the spirit of the south, don't miss the unmissable pétanque area—a place of typical Provençal conviviality, in the natural shade of the trees or under the guinguette lights at dusk.\nA joyful and unifying moment, filled with laughter, relaxation, and friendly competition... So, are you shooting or pointing?","id":2,"title":"The shaded expanse"},"47fbec0b-7132-4186-a0f5-4593dd810ee2":{"photo":"Valbonne Estate","image":"wix:image:\/\/v1\/314229_809d4b0d92854ff7b65b55b73c37fe3a~mv2.jpg\/clairiere.jpg#originWidth=4032&originHeight=1908","description":"This natural space is highly prized in Provence for its coolness and unique interplay of light.\n\nIn the clearing, along the Canet stream, which has been restored to its former glory, you can freely imagine your own décor and layout: a secular ceremony or a rustic brunch in the shade of centuries-old oaks, strawberry trees, or laurels.\nA peaceful and enchanting setting that leaves no one unmoved.","title_en":"The clearing","_id":"47fbec0b-7132-4186-a0f5-4593dd810ee2","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:55:41.560Z"},"_updatedDate":{"$date":"2025-11-26T14:13:00.792Z"},"description_en":"This natural space is highly prized in Provence for its coolness and unique play of light.\n\nIn the clearing, along the Canet stream, which has been restored to its former glory, you can freely imagine your own decorations and arrangements: a secular ceremony or a country brunch in the shade of century-old oak trees, arbutus trees, or laurels.\nA peaceful and enchanting setting that leaves no one indifferent.","id":3,"title":"The meadow"},"49ec722f-e8d4-4813-9c05-740664431e5d":{"photo":"Karma Stories","image":"wix:image:\/\/v1\/11d052_26ccb733c9814cc7bde8bf4493b1e2d0~mv2.jpg\/MariageEllieetJack_-4%20(1).jpg#originWidth=2048&originHeight=1365","description":"The cocktail reception or drinks reception takes place around the Domaine's heated 13 x 7 meter swimming pool, surrounded by spacious terraces, a travertine and wood bar, and elegant lounge areas.\n\nLocated on the elevated part of the Domaine de Valbonne, this space offers your guests breathtaking views of the historic building and the quintessential Provençal landscape: vineyards, lavender fields, and olive groves stretching as far as the eye can see. A refined yet tranquil setting, ideal for a sunset cocktail or a relaxed brunch.","title_en":"Pool area","_id":"49ec722f-e8d4-4813-9c05-740664431e5d","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:54:54.031Z"},"_updatedDate":{"$date":"2025-11-26T14:13:36.003Z"},"description_en":"The cocktail reception or wine reception takes place around the estate's swimming pool, a 13 x 7 meter heated pool surrounded by spacious terraces, a travertine and wood bar, and elegant lounge areas.\n\nLocated on the elevated part of the Domaine de Valbonne, this space offers your guests a breathtaking view of the historic building and the typical Provencal landscape: vineyards, lavender fields, and olive trees as far as the eye can see.\nA refined and soothing setting, ideal for a cocktail at sunset or a relaxed brunch.","id":4,"title":"The swimming pool area"},"1da763a9-3aa7-4f61-bf7d-c996e350f2ca":{"photo":"Anais Bizet","image":"wix:image:\/\/v1\/11d052_f302aef5de2c4c05a3bc226704cac134~mv2.jpg\/daphn%C3%A9-et-valentin-130.jpg#originWidth=2048&originHeight=1365","description":"Bathed in the soft glow of string lights, your wedding dinner in Provence transforms into a magical evening under the stars, in a warm and elegant atmosphere.\n\nAnd because charm isn't dependent on the weather, a custom-made temporary canopy can be installed to protect your guests without compromising the authentic character of the venue.","title_en":"The village courtyard","_id":"1da763a9-3aa7-4f61-bf7d-c996e350f2ca","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:57:22.359Z"},"_updatedDate":{"$date":"2025-11-26T14:11:29.337Z"},"description_en":"Under the glow of fairy lights, your wedding dinner in Provence will be transformed into a magical evening under the stars, in a friendly and elegant atmosphere.\n\nAnd because charm doesn't depend on the weather, a custom-made canopy can be installed to protect your guests without altering the authentic spirit of the venue.","id":5,"title":"The village courtyard"},"98a3b440-7f8f-49d9-826e-a883763b987f":{"photo":"Neupap photography","image":"wix:image:\/\/v1\/11d052_82a0346c5c544fda882442cdb4b65803~mv2.jpg\/155-BTSLindaValbonne-ZephyrKokPhotography%20(1).jpg#originWidth=1024&originHeight=576","description":"Host your ceremony or intimate wedding dinner amidst the olive groves of Domaine de Valbonne, in a peaceful, light-filled atmosphere.\nBeneath the silvery branches of these centuries-old trees, your guests will enjoy a natural and authentic setting, quintessentially Provençal. Appropriate lighting is essential to enhance this space: luminous canopies or curtains of light highlight the trees and create a magical atmosphere after nightfall.\nA venue that combines elegance, nature, and conviviality, perfect for extending the magic of your Provençal wedding. An emblematic tree of the South of France, the olive tree embodies peace, honor, and immortality—symbols that resonate with the promise of eternal love.","title_en":"Olive trees","_id":"98a3b440-7f8f-49d9-826e-a883763b987f","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:54:04.820Z"},"_updatedDate":{"$date":"2025-11-26T14:15:38.678Z"},"description_en":"Organize your intimate wedding ceremony or reception in the heart of the olive groves at Domaine de Valbonne, in a peaceful atmosphere bathed in light.\nUnder the silvery branches of these century-old trees, your guests will enjoy a natural and authentic setting, typical of Provence.\nAppropriate lighting is essential to enhance this space: luminous skies or curtains of light highlight the trees and create a magical atmosphere once night falls.\nA place that combines elegance, nature, and conviviality, perfect for prolonging the magic of your wedding in Provence.\nAn iconic tree of the south of France, the olive tree embodies peace, honor, and immortality—symbols that echo the promise of eternal love.","id":6,"title":"The olive trees"},"135caa65-24b6-42cf-964f-57a66969e68b":{"photo":"Eli Elle","image":"wix:image:\/\/v1\/11d052_b2a8bc8ff42f48e7a845655ba7977863~mv2.jpg\/SA-190725-valbonne-elielle-hd-769%20(1).jpg#originWidth=4000&originHeight=2667","description":"Facing the courtyard of the Domaine de Valbonne, a 100 m² barn, fully renovated and air-conditioned, offers the perfect setting for your dance floor and musical evening, with breathtaking views of the olive groves and lavender fields.\n\nIts blend of stone, glass, and wrought iron, enhanced by sparkling disco balls and a welcoming bar, creates an elegant and refined party atmosphere, perfect for extending the evening into the early hours. Let the dancing begin!\n\nAt the entrance to the Domaine, this magnificent Provençal barn can also be transformed into a charming setting for a secular ceremony or a romantic dinner, offering a sumptuous view of the Provençal countryside.","title_en":"The dance floor","_id":"135caa65-24b6-42cf-964f-57a66969e68b","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:56:31.738Z"},"_updatedDate":{"$date":"2025-11-26T14:12:30.718Z"},"description_en":"Opposite the courtyard of the Domaine de Valbonne, a 1,000-square-foot barn, completely renovated and air-conditioned, provides the perfect setting for your dance floor and musical evening, with breathtaking views of olive trees and lavender fields.\n\nIts blend of stone, glass, and wrought iron, enhanced by sparkling mirror balls and a cozy night bar, creates an elegant and refined party atmosphere, perfect for extending the evening into the night.Let the dancing begin!\n\nAt the entrance to the estate, this magnificent Provençal barn can also be transformed into a charming setting for a secular ceremony or a romantic dinner, offering a sumptuous view of the Provençal countryside.","id":7,"title":"The dance hall"},"22584002-4d95-4bdf-b9f4-670f0a80d027":{"photo":"Valbonne Estate","image":"wix:image:\/\/v1\/11d052_9e6d68d42fdc424db3ef1fb00bbd69df~mv2.jpg\/caves%20vout%C3%A9es.jpg#originWidth=6068&originHeight=3413","description":"Facing the courtyard of the Domaine de Valbonne, 115 square meters of magnificent vaulted cellars have been fully restored.\n\nThe charm of the exposed stone, the natural coolness of the period walls, and the wrought-iron windows create an authentic and intimate atmosphere, enhanced by a luminous starry sky that illuminates the vault with a thousand reflections.\n\nA magical space to host your dinner, ceremony, or cocktail reception, even in rain or wind.","title_en":"The vaulted space","_id":"22584002-4d95-4bdf-b9f4-670f0a80d027","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:57:38.980Z"},"_updatedDate":{"$date":"2025-11-26T14:10:51.484Z"},"description_en":"Facing the courtyard of the Domaine de Valbonne, 1,200 square feet of magnificent vaulted cellars have been completely restored.\nThe charm of exposed stonework, the natural coolness of period walls, and wrought-iron windows create an authentic and intimate atmosphere, enhanced by a bright starry sky that illuminates the vaulted ceiling with a thousand reflections.\n\nA magical space to host your dinner, ceremony, or cocktail party, even in case of rain or wind.","id":8,"title":"The vaulted space"},"fb1112e9-9863-4148-a31f-111b2902b4e4":{"photo":"Valbonne Estate","image":"wix:image:\/\/v1\/314229_c5bc6ab27d8b43e3bd4098c5274112b0~mv2.png\/vieillegrange.png#originWidth=1494&originHeight=1170","description":"At the entrance to the Domaine de Valbonne stands a 90 m² Provençal stone barn, preserved in all its original charm.\n\nIts exposed stone walls and timber frame create a space full of character, ideal for hosting your wedding ceremony, an intimate cocktail reception, or a sheltered brunch in case of rain or strong winds.","title_en":"The old barn","_id":"fb1112e9-9863-4148-a31f-111b2902b4e4","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:56:57.189Z"},"_updatedDate":{"$date":"2025-11-26T14:11:58.690Z"},"description_en":"At the entrance to the Domaine de Valbonne stands an old Provençal stone barn measuring 90 m², preserved in all its authenticity.\nIts exposed stonework and wooden beams make it a charming space, ideal for hosting your wedding ceremony, an intimate cocktail party, or a sheltered brunch in case of rain or mistral winds.","id":9,"title":"The old barn"},"babc8fe6-a9b6-440a-96d0-86cbc6557b66":{"image":"wix:image:\/\/v1\/314229_a5c45102eaad460ca884a26c3a65b78e~mv2.webp\/photoDV-480x306.webp#originWidth=480&originHeight=306","description":"At Domaine de Valbonne, we place particular emphasis on the satisfaction of your service providers.\n\nBecause happy teams make for happy brides and grooms and guests, we do everything we can to offer them the best working conditions.\n\nThe Domaine boasts exceptional, top-of-the-range facilities for your caterer and event teams: a large, fully equipped professional kitchen, a cold room, an ice machine, and a 90 m² preparation room allowing for simultaneous plating, ensuring all your guests enjoy seamless service and a perfect dinner.\n\nEverything is in place to guarantee a successful and delightful wedding reception in the heart of Provence.","title_en":"Pro area","_id":"babc8fe6-a9b6-440a-96d0-86cbc6557b66","_owner":"31422973-76c1-4881-aa2b-8cd3669e33f0","_createdDate":{"$date":"2023-04-16T14:57:47.355Z"},"_updatedDate":{"$date":"2025-11-26T14:10:02.315Z"},"description_en":"At Domaine de Valbonne, we pay particular attention to the satisfaction of your service providers.\nBecause happy teams make for happy newlyweds and guests, we do everything we can to offer them the best working conditions.\n\nThe Domaine has rare, high-end facilities for your caterer and event teams:\na large, fully equipped professional kitchen, a cold room, an ice machine, and a 90 m² preparation room where plates can be prepared simultaneously so that all your guests can enjoy smooth service and a perfect dinner.\n\nEverything is in place to guarantee a successful and delicious wedding reception in the heart of Provence.","id":10,"title":"The professional area"}}},"uniqueFieldValuesByCollection":{"Ledomaine":{}}}},"675bbcef-18d8-41f5-800e-131ec9e08762":{"importedNamespaces":["wix-location","wix-window","wix-data","wix-pro-gallery-backend"]}},"builderComponentsWarmupData":{},"ooi":{"failedInSsr":{}}}</script>
