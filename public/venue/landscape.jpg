6 wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:roboto-bold,roboto,sans-serif;" class="wixui-rich-text__text"><span style="font-size:11px;" class="wixui-rich-text__text"><span style="letter-spacing:0.01em;" class="wixui-rich-text__text">16TH CENTURY MAS</span></span></span></span></span></p></div><!--/$--><!--$--><div id="comp-lesxj3dz" class="comp-lesxj3dz wH18kY"><div data-mesh-id="comp-lesxj3dzinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-lesxj3dzinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le368908" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le368908 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:77px; line-height:1.3em;"><span class="color_22 wixui-rich-text__text"><span style="font-size:77px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text"><span style="letter-spacing:0em;" class="wixui-rich-text__text">140</span></span></span></span></p></div><!--/$--><!--$--><div id="comp-le36890h" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le36890h wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:11px; line-height:1.3em;"><span class="color_16 wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:roboto-bold,roboto,sans-serif;" class="wixui-rich-text__text"><span style="font-size:11px;" class="wixui-rich-text__text"><span style="letter-spacing:0.01em;" class="wixui-rich-text__text">GUESTS</span></span></span></span></span></p></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-le368rgz" class="comp-le368rgz wH18kY"><div data-mesh-id="comp-le368rgzinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-le368rgzinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le368ro3" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le368ro3 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:77px; line-height:1.3em;"><span class="color_22 wixui-rich-text__text"><span style="font-size:77px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text"><span style="letter-spacing:0em;" class="wixui-rich-text__text">56</span></span></span></span></p></div><!--/$--><!--$--><div id="comp-le368ro9" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le368ro9 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:11px; line-height:1.3em;"><span class="color_16 wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:roboto-bold,roboto,sans-serif;" class="wixui-rich-text__text"><span style="font-size:11px;" class="wixui-rich-text__text"><span style="letter-spacing:0.01em;" class="wixui-rich-text__text">BEDS<br class="wixui-rich-text__text">ON THE SPOT</span></span></span></span></span></p></div><!--/$--></div></div></div><!--/$--><!--$--><div id="comp-le369217" class="comp-le369217 wH18kY"><div data-mesh-id="comp-le369217inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-le369217inlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le36926v" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le36926v wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:77px; line-height:1.3em;"><span class="color_22 wixui-rich-text__text"><span style="font-size:77px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text"><span style="letter-spacing:0em;" class="wixui-rich-text__text">35</span></span></span></span></p></div><!--/$--><!--$--><div id="comp-le3692711" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le3692711 wixui-rich-text" data-testid="richTextElement"><p class="font_2 wixui-rich-text__text" style="font-size:11px; line-height:1.3em;"><span class="color_16 wixui-rich-text__text"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-family:roboto-bold,roboto,sans-serif;" class="wixui-rich-text__text"><span style="font-size:11px;" class="wixui-rich-text__text"><span style="letter-spacing:0.01em;" class="wixui-rich-text__text">HECTARES</span></span></span></span></span></p></div><!--/$--></div></div></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-le36izyq" tabindex="-1" class="Le88gL comp-le36izyq wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-le36izyq" data-hook="bgLayers" data-motion-part="BG_LAYER comp-le36izyq" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-le36izyq" data-motion-part="BG_MEDIA comp-le36izyq" class="ROWgFb"></div></div><div data-mesh-id="comp-le36izyqinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-le36izyqinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-le36jmj9" class="W4V2qg comp-le36jmj9 wixui-image" title="Ben Levy"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="799px" srcSet="https://static.wixstatic.com/media/314229_2af34e92af2c48a29944819b5c6e190a~mv2.webp/v1/fill/w_799,h_533,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/MariageMarie%2BSt%C3%A9phane-00323-BL108890_jpg_1280.webp 1x, https://static.wixstatic.com/media/314229_2af34e92af2c48a29944819b5c6e190a~mv2.webp/v1/fill/w_1280,h_854,al_c,q_85,enc_avif,quality_auto/MariageMarie%2BSt%C3%A9phane-00323-BL108890_jpg_1280.webp 2x" id="img_comp-le36jmj9" src="https://static.wixstatic.com/media/314229_2af34e92af2c48a29944819b5c6e190a~mv2.webp/v1/fill/w_799,h_533,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/MariageMarie%2BSt%C3%A9phane-00323-BL108890_jpg_1280.webp" alt="Married at Domaine de Valbonne, an illustration of wedding packages in Provence" style="object-fit:cover" class="gRkIq0 sFiSiq" width="799" height="533"/></div></div><!--/$--><!--$--><div id="comp-le36kpqc" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le36kpqc wixui-rich-text" data-testid="richTextElement"><h2 class="font_2 wixui-rich-text__text" style="font-size:45px; line-height:1.1em;"><span class="color_35 wixui-rich-text__text"><span style="font-size:45px;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text">Your tailor-made wedding in Provence</span></span></span></h2></div><!--/$--><!--$--><div id="comp-le36lbtv" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le36lbtv wixui-rich-text" data-testid="richTextElement"><h3 class="font_3 wixui-rich-text__text" style="font-size:20px;"><span class="color_30 wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="font-style:italic;" class="wixui-rich-text__text"><span style="font-family:playfair display,serif;" class="wixui-rich-text__text">The entire estate can be privatized.</span></span></span></span></h3></div><!--/$--><!--$--><div id="comp-le36lq2r" class="N8MGzv _v6ohL PO9MfV AWXfZq comp-le36lq2r wixui-rich-text" data-testid="richTextElement"><p class="font_7 wixui-rich-text__text" style="font-size:15px;">An authentic and welcoming place, Domaine de Valbonne offers a unique atmosphere where you will truly feel “at home”.</p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;">It's the ideal setting to organize your reception and bring your loved ones together in a natural and refined setting.<br class="wixui-rich-text__text"> Religious or secular ceremony, sunset cocktail, dinner under the stars, dance party or the following day's brunch: several spaces in the Domaine have been designed so that each highlight of your wedding finds its magical setting.</p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;">&nbsp;</p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;">Whether it's a small wedding, an exclusive fairytale-style celebration, or a tailor-made private event, Domaine de Valbonne adapts to all your desires.<br class="wixui-rich-text__text"> Wedding, seminar or professional event: this exceptional venue is designed to create unforgettable memories in a natural and intimate environment.</p> 
<p class="font_7 wixui-rich-text__text" style="font-size:15px;">&nbsp;</p></div><!--/$--><!--$--><div id="comp-le36mdnm" class="comp-le36mdnm" data-semantic-classname="button"><a data-testid="linkElement" href="https://www.domainedevalbonne.com/mariage-en-provence" target="_self" class="StylableButton2545352419__root style-leszi3d3__root wixui-button StylableButton2545352419__link" aria-label="WEDDING PACKAGES"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">WEDDING PACKAGES</span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span><svg data-bbox="13.05 2.55 33.878 54.8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60">
