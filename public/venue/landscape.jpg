omp-lesxo31j":"ClassicSection","comp-lgmck96h":"Group","comp-lgmck99x":"WRichText","comp-lgmck9a0":"WRichText","comp-lgmck9a3":"WRichText","comp-lgmck9a5":"WRichText","comp-lgmck9a8":"WRichText","comp-lgmck9ab":"WRichText","comp-lgmck9ae":"WRichText","comp-lgmck9aj":"WRichText","comp-lgmck9al":"WRichText","pageBackground_tuckg":"PageBackground","DYNAMIC_STRUCTURE_CONTAINER":"DynamicStructureContainer","site-root":"DivWithChildren","main_MF":"DivWithChildren","tuckg_wrapper":"PageMountUnmount","tuckg_wrapper_background":"PageMountUnmount"}},"appsWarmupData":{"14409595-f076-4753-8303-9a86f9f71469":{"vodWidgetData-comp-lee53aoq":"{\"__CHANNEL__\":{\"channelType\":\"channel\",\"itemType\":\"list\",\"state\":null,\"metaSiteId\":\"04b1114c-e498-4ed3-bc2a-8078745cef19\",\"featuredItem\":null,\"title\":\"internal\",\"description\":null,\"dealInfo\":[],\"subscriptionOnly\":false,\"mediaType\":\"secure_video\",\"mediaExternUrl\":null,\"externalId\":null,\"externalCreatedTs\":\"1970-01-01T00:00:00.000Z\",\"urlType\":\"\",\"mediaFileName\":null,\"mediaStatus\":null,\"mediaInfo\":null,\"trailerInfo\":null,\"customUploadedCoverUrl\":null,\"customCoverUrl\":null,\"coverUrl\":null,\"thumbnailUrl\":null,\"statsInfo\":{\"categories\":[],\"tags\":[]},\"categories\":[],\"tags\":[],\"ownerId\":\"230e809a-63ef-4095-a268-e1f718f14739\",\"premiumOwner\":true,\"premiumInfo\":{\"product\":\"Core\",\"itemMilliseconds\":-1,\"milliseconds\":18000000,\"bytes\":53687091200},\"onPublishedSite\":true,\"publishedTs\":1789244196,\"dateCreated\":\"2026-09-12T20:16:35.996Z\",\"createdTs\":null,\"updatedTs\":null,\"id\":\"04b1114c-e498-4ed3-bc2a-8078745cef19\",\"videosCount\":1},\"__SINGLE_VIDEO__\":{\"listOrder\":0,\"sourceUrl\":null,\"itemType\":\"item\",\"isPublic\":true,\"height\":360,\"width\":640,\"metaSiteId\":\"04b1114c-e498-4ed3-bc2a-8078745cef19\",\"listId\":\"04b1114c-e498-4ed3-bc2a-8078745cef19\",\"baseItemId\":\"7c4d3ff1c3224e9ebb1fd589d7f2276d\",\"itemId\":\"7c4d3ff1c3224e9ebb1fd589d7f2276d\",\"title\":\"A Magical September Wedding Under the Provençal Stars | Amélie & Lucas – Domaine de Valbonne\",\"description\":\"A beautiful memory from a magical late-September weekend in the heart of Provence — surrounded by loved ones and bathed in golden light. \\nAmélie & Lucas celebrated their love at Domaine de Valbonne in an atmosphere that was as natural and heartfelt as it was elegant and refined. Under a perfectly clear sky, they dined under the stars, enjoying magnificent weather that made every moment even more special.\\n\\nAn amazing couple — kind, funny, and incredibly thoughtful — with whom we built a truly special connection over the months of planning and during these three unforgettable days. Days filled with laughter, emotion, sharing, and timeless memories that will remain engraved in our hearts.\\n\\n🎥 Dive into the teaser of their wedding — a joyful, love-filled glimpse into a truly magical celebration.\\n📹 Videographer – Stéphane Morin\\n\\n\\n🍽️ Catering – Pop’e Truck & Maison Nans\\n🌸 Florals – Sébastien Le Fleuriste\\n💄 Hair & makeup – Marion Carpentier & Blush Agency\\n🎧 DJ – Florian Falgairolle (Exclusivity Events)\\n🎷 Live music – Émilie DLF\\n📸 Photographer – Tao (Via Ben Levy)\\n\\nUn doux souvenir d’un week-end magique de fin septembre, au cœur de la Provence, entourés d’êtres chers et baignés de lumière dorée. 🌿✨\\nAmélie & Lucas ont célébré leur amour au Domaine de Valbonne dans une atmosphère à la fois naturelle, chaleureuse et profondément élégante. Sous un ciel parfaitement dégagé, ils ont dîné sous les étoiles, profitant d’un temps magnifique qui a sublimé chaque instant.\\n\\nUn couple génial, d’une bienveillance et d’un humour incroyables, avec qui un lien fort s’est naturellement créé au fil des préparatifs et de ces trois jours uniques. Trois jours de rires, d’émotions, de partage et de moments suspendus, qui resteront à jamais gravés dans les mémoires.\\n\\n🎥 Découvrez le teaser de leur mariage, un concentré d’amour, de joie et de beauté, dans ce lieu hors du temps.\\n\\n#weddinginprovence #destinationwedding #mariageenprovence #underthestars #domainevalbonne #weddingteaser #mariagesouslesétoiles #weddingvideo #luxurywedding #mariageromantique #southoffrancewedding #filmdemariage #weddinginfrance\",\"publisher\":\"Le Domaine de Valbonne\",\"videoType\":null,\"genre\":null,\"categories\":[\"Howto & Style\"],\"tags\":[],\"crew\":[],\"cast\":[],\"videoSource\":\"youtube\",\"state\":\"visible\",\"durationSec\":125,\"durationStr\":\"02:05\",\"dealInfo\":[{\"type\":\"rent\",\"price\":0.01,\"enabled\":false,\"period\":24},{\"type\":\"sale\",\"price\":0.01,\"enabled\":false,\"period\":0}],\"embedOptions\":{\"enabled\":false,\"showShare\":false,\"showInfo\":false,\"logoVisibility\":null,\"selectedLogoUrl\":\"\"},\"customUploadedCoverUrl\":null,\"customCoverUrl\":\"https:\/\/i.ytimg.com\/vi\/7tbpBMzCBQE\/maxresdefault.jpg\",\"coverUrl\":\"https:\/\/i.ytimg.com\/vi\/7tbpBMzCBQE\/maxresdefault.jpg\",\"posterUrl\":null,\"previewType\":\"none\",\"contentRating\":null,\"memberOnly\":false,\"mediaType\":\"secure_video\",\"mediaExternUrl\":\"https:\/\/www.youtube.com\/embed\/7tbpBMzCBQE\",\"externalId\":\"7tbpBMzCBQE\",\"mediaFileName\":null,\"mediaInfo\":null,\"trailerFileName\":null,\"trailerInfo\":null,\"publishChanges\":true,\"datePublish\":\"2026-09-12T20:16:36.054Z\",\"listAdded\":1676977506,\"ownerId\":\"31422973-76c1-4881-aa2b-8cd3669e33f0\",\"playInfo\":{\"status\":\"SUCCESS\",\"message\":\"OK\",\"type\":\"CONTENT\",\"url\":\"https:\/\/www.youtube.com\/embed\/7tbpBMzCBQE\"},\"seoInfo\":{\"status\":\"WARNING\",\"message\":\"Video is not available for SEO play\",\"type\":\"CONTENT\",\"url\":null},\"subtitlesInfo\":{\"status\":\"WARNING\",\"message\":\"Video with YOUTUBE source is not available for subtitles\",\"type\":\"SUBTITLES\",\"url\":null},\"id\":\"7c4d3ff1c3224e9ebb1fd589d7f2276d\",\"transcodingStatus\":\"READY\",\"trailerTranscodingStatus\":\"NONE\",\"createdTs\":null,\"updatedTs\":nu