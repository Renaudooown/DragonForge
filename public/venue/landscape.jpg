  <meta property="og:description" content="Experience an unforgettable wedding at Domaine de Valbonne in Provence. Discover our 16th-century mas, our top-of-the-range accommodation and our personalized services for your special event."/>
  <meta property="og:image" content="https://static.wixstatic.com/media/314229_94b097b22ad04b82a093401ebef89155%7Emv2.jpg/v1/fit/w_2500,h_1330,al_c/314229_94b097b22ad04b82a093401ebef89155%7Emv2.jpg"/>
